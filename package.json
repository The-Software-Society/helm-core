{
  "name": "helm-core",
  "productName": "Helm Core",
  "version": "0.1.0",
  "description": "A macOS desktop hub for running and steering Claude Code and Codex agent sessions across all your projects.",
  "main": "out/main/index.js",
  "author": "The Software Society",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "rebuild": "electron-rebuild -f -w node-pty,better-sqlite3",
    "postinstall": "electron-rebuild -f -w node-pty,better-sqlite3",
    "dist": "electron-vite build && electron-builder --mac --dir && bash scripts/sign-macos.sh 'release/mac-arm64/Helm Core.app'",
    "test": "node scripts/test.mjs",
    "test:recovery": "pnpm build && node scripts/test-recovery.mjs",
    "install:mac": "bash scripts/install-macos.sh",
    "update:prepare": "bash scripts/prepare-update.sh",
    "test:updates": "python3 -m unittest discover -s scripts -p \"test_updates.py\"",
    "test:update-live": "node scripts/test-update-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "electron-native-speech": "^0.1.6",
    "electron-native-speech-backend-macos": "^0.1.7",
    "nanoid": "^6.0.1",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@electron/rebuild": "^4.2.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/prompt": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "node-pty",
      "esbuild",
      "@tailwindcss/oxide"
    ]
  },
  "build": {
    "appId": "io.helm-core.app",
    "productName": "Helm Core",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!out/tests/**"
    ],
    "asar": false,
    "npmRebuild": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "darkModeSupport": true,
      "identity": null,
      "extendInfo": {
        "NSSpeechRecognitionUsageDescription": "Helm transcribes speech into prompts you can review before sending.",
        "NSMicrophoneUsageDescription": "Helm uses the microphone when you choose to dictate a prompt."
      }
    },
    "extraResources": [
      {
        "from": "scripts/helm-update.py",
        "to": "helm-update.py"
      },
      {
        "from": "node_modules/electron-native-speech-backend-macos/bin/SpeechHelper.app",
        "to": "SpeechHelper.app"
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
