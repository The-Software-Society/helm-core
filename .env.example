# Helm Core needs no API keys. These optional variables are for development and testing.
# HELM_DATA_DIR=/tmp/helm-scratch      # isolate the database, logs and runtime files
# HELM_PORT=47831                      # pin the background service port
# HELM_DEBUG_DIR=/tmp/helm-dbg         # enable the UI driver (cmd.js -> shot.png, result.json)
# HELM_DEV_DATA_DIR=/tmp/helm-dev      # data folder used by `pnpm dev`
